<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {% set pageTitle = title or site.title %}
  {% set pageDesc = description or site.description %}
  {% set canonical = site.url + page.url %}
  {% set ogImg = image or site.ogImage %}

  <title>{{ pageTitle }}{% if title and page.url != "/" %} — {{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ canonical }}">

  <!-- OpenGraph -->
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:type" content="{% if schema == 'article' %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ ogImg }}">
  <meta property="og:site_name" content="{{ site.name }}">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  <meta name="twitter:image" content="{{ ogImg }}">

  <!-- Favicon: brand spiral -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='-50 -50 100 100'><path fill='none' stroke='white' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round' d='M 0 0 L 0.65 -0.16 L 1.16 -0.6 L 1.41 -1.27 L 1.34 -2.05 L 0.92 -2.81 L 0.18 -3.4 L -0.83 -3.71 L -1.99 -3.66 L -3.16 -3.21 L -4.16 -2.36 L -4.84 -1.16 L -5.06 0.27 L -4.74 1.81 L -3.85 3.31 L -2.46 4.59 L -0.66 5.51 L 1.4 5.91 L 3.55 5.71 L 5.62 4.86 L 7.4 3.36 L 8.69 1.28 L 9.31 -1.26 L 9.16 -4.05 L 8.16 -6.88 L 6.32 -9.51 L 3.7 -11.7 L 0.43 -13.21 L -3.27 -13.86 L -7.16 -13.5 L -10.94 -12.05 L -14.34 -9.55 L -17.07 -6.07 L -18.86 -1.78 L -19.51 3.04 L -18.96 8.05 L -17.21 12.97 L -14.34 17.49 L -10.51 21.31 L -5.93 24.16 L -0.85 25.83 L 4.42 26.16 L 9.6 25.07 L 14.36 22.55 L 18.4 18.7 L 21.43 13.71 L 23.21 7.83 L 23.6 1.39 L 22.5 -5.27 L 19.93 -11.78 L 16 -17.81 L 10.93 -23.04 L 5.05 -27.18 L -1.39 -29.99 L -8.07 -31.27 L -14.74 -30.92 L -21.06 -28.86 L -26.78 -25.13 L -31.59 -19.85 L -35.21 -13.27 L -37.41 -5.69 L -38.04 2.49 L -37.05 10.83 L -34.45 18.85 L -30.39 26.21 L -25.05 32.61 L -18.65 37.79 L -11.51 41.55 L -3.94 43.74 L 3.69 44.27 L 11.06 43.13 L 17.83 40.39 L 23.66 36.16 L 28.27 30.59 L 31.45 23.92 L 33.05 16.43 L 32.99 8.43 L 31.28 0.27 L 28.01 -7.71 L 23.36 -15.18 L 17.49 -21.83 L 10.66 -27.34 L 3.16 -31.49 L -4.7 -34.13 L -12.6 -35.16 L -20.16 -34.57 L -27.06 -32.42 L -33.06 -28.81 L -37.94 -23.96 L -41.55 -18.13 L -43.83 -11.65 L -44.74 -4.87 L -44.32 1.84 L -42.62 8.16 L -39.77 13.81 L -35.93 18.55 L -31.27 22.18 L -26 24.59 L -20.31 25.71 L -14.43 25.55 L -8.55 24.18'/></svg>">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Manrope:wght@300;400;500&display=swap" rel="stylesheet">

  <!-- JSON-LD structured data -->
  {% if schema == "article" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ (title or site.title) | dump | safe }},
    "description": {{ pageDesc | dump | safe }},
    "datePublished": "{{ date | isoDate }}",
    "dateModified": "{{ (dateModified or date) | isoDate }}",
    "author": { "@type": "Person", "name": {{ site.author | dump | safe }} },
    "publisher": { "@type": "Organization", "name": {{ site.name | dump | safe }} },
    "url": {{ canonical | dump | safe }},
    "mainEntityOfPage": { "@type": "WebPage", "@id": {{ canonical | dump | safe }} }
  }
  </script>
  {% else %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ site.name | dump | safe }},
    "description": {{ site.description | dump | safe }},
    "url": {{ site.url | dump | safe }}
  }
  </script>
  {% endif %}

  <style>
    :root {
      --bg: #000000;
      --ink: #f3efe7;
      --ink-bright: #ffffff;
      --muted: #8a8780;
      --measure: 680px;
    }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: "Manrope", system-ui, -apple-system, sans-serif;
      font-weight: 400;
      font-size: 1.125rem;
      line-height: 1.75;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    .wrap {
      max-width: var(--measure);
      margin: 0 auto;
      padding: 12vh 1.5rem 16vh;
    }
    a { color: var(--ink-bright); text-decoration: none; border-bottom: 1px solid rgba(243,239,231,0.28); transition: border-color .2s ease; }
    a:hover { border-color: var(--ink-bright); }
    h1, h2, h3 {
      font-family: "Cormorant Garamond", Georgia, serif;
      font-weight: 500;
      color: var(--ink-bright);
      line-height: 1.15;
      letter-spacing: 0.01em;
    }
    h1 { font-size: clamp(2.2rem, 6vw, 3.4rem); margin: 0 0 0.4em; }
    h2 { font-size: 1.9rem; margin: 2.4em 0 0.6em; }
    p { margin: 0 0 1.4em; }
    time, .meta { color: var(--muted); font-size: 0.95rem; letter-spacing: 0.04em; }
    article p, article li { color: var(--ink); }
    hr { border: none; border-top: 1px solid rgba(243,239,231,0.14); margin: 4rem 0; }
    .corpus-list { list-style: none; margin: 0; padding: 0; }
    .corpus-list li { margin: 0 0 3.2rem; }
    .corpus-list a.entry-title { display: inline-block; border: none; }
    .corpus-list h2 { margin: 0 0 0.25rem; font-size: 1.8rem; }
    .corpus-list .excerpt { color: var(--muted); margin: 0.4rem 0 0; font-size: 1rem; line-height: 1.6; }
    .subscribe { margin-top: 5rem; }
    .subscribe a { color: var(--muted); border-bottom-color: rgba(138,135,128,0.4); font-size: 1rem; letter-spacing: 0.02em; }
    .subscribe a:hover { color: var(--ink-bright); border-bottom-color: var(--ink-bright); }
    .home-link { display: inline-block; margin-bottom: 4rem; color: var(--muted); border: none; font-size: 0.9rem; letter-spacing: 0.08em; text-transform: lowercase; }
    .home-link:hover { color: var(--ink-bright); }
  </style>
</head>
<body>
  <div class="wrap">
    {% block content %}{% endblock %}
  </div>
</body>
</html>
